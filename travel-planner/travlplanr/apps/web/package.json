{
  "name": "web",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "NG_CLI_ANALYTICS=false ng serve web --host 0.0.0.0 --port 4200 --proxy-config proxy.conf.js",
    "start:edge": "NODE_OPTIONS='--require ./dev-server/edge-hmr-hook.cjs' DEV_PUBLIC_HOST=dev.travlplanr.com DEV_PUBLIC_PORT=443 NG_CLI_ANALYTICS=false ng serve web --host 0.0.0.0 --port 4200 --proxy-config proxy.conf.js --configuration edge",
    "start:ssl": "NG_CLI_ANALYTICS=false ng serve web --host 0.0.0.0 --port 4200 --ssl --proxy-config proxy.conf.js",
    "start:admin": "NG_CLI_ANALYTICS=false ng serve admin --host 0.0.0.0 --port 4320 --proxy-config proxy.conf.js",
    "start:4201": "NG_CLI_ANALYTICS=false ng serve web --port 4201 --proxy-config proxy.conf.js",
    "start:proxy-debug": "PROXY_LOG_LEVEL=debug NG_CLI_ANALYTICS=false ng serve web --host 0.0.0.0 --port 4200 --proxy-config proxy.conf.js",
    "build": "ng build",
    "build:ui": "ng build ui",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "test:features": "npx --yes tsx scripts/test-chat-features.ts",
    "test:chat": "npm run test:features && bash scripts/test-chat-integration.sh",
    "test:destination-tiers": "bash scripts/test-destination-tiers-integration.sh",
    "test:all-chat": "npm run test:features && bash scripts/test-chat-integration.sh && bash scripts/test-destination-tiers-integration.sh",
    "lint:hex": "node scripts/check-hardcoded-hex.mjs",
    "codegen:openapi": "python3 ../../scripts/export_openapi.py",
    "codegen:api": "node scripts/codegen-api.mjs",
    "codegen": "npm run codegen:openapi && npm run codegen:api",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^21.2.19",
    "@angular/cdk": "^21.2.14",
    "@angular/common": "^21.2.19",
    "@angular/compiler": "^21.2.19",
    "@angular/core": "^21.2.19",
    "@angular/forms": "^21.2.19",
    "@angular/platform-browser": "^21.2.19",
    "@angular/platform-browser-dynamic": "^21.2.19",
    "@angular/platform-server": "^21.2.19",
    "@angular/router": "^21.2.19",
    "@angular/ssr": "^21.2.20",
    "@ngx-translate/core": "^18.0.0",
    "@ngx-translate/http-loader": "^18.0.0",
    "@sentry/angular": "^10.60.0",
    "@types/leaflet": "^1.9.21",
    "autoprefixer": "^10.5.0",
    "html2pdf.js": "^0.14.0",
    "leaflet": "^1.9.4",
    "ngx-quill": "^29.2.0",
    "postcss": "^8.5.15",
    "quill": "^2.0.2",
    "rxjs": "~7.8.0",
    "tailwindcss": "^3.4.19",
    "tslib": "^2.3.0",
    "zone.js": "~0.15.1"
  },
  "devDependencies": {
    "@angular/build": "^21.2.20",
    "@angular/cli": "^21.2.20",
    "@angular/compiler-cli": "^21.2.19",
    "@playwright/test": "^1.61.1",
    "@types/jasmine": "~5.1.0",
    "@types/quill": "^2.0.14",
    "jasmine-core": "~5.1.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "ng-packagr": "^21.2.7",
    "openapi-typescript": "^7.13.0",
    "typescript": "~5.9.3"
  }
}
