  "info": {
    "description": "Dashboard read models, audit events, notifications, status counts.",
    "title": "Travlplanr Reporting Service",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/v1/admin/dashboard/customer-growth": {
      "get": {
        "description": "Customer growth bars \u2014 absolute new-customer count per month (not %).",
        "operationId": "get_customer_growth_api_v1_admin_dashboard_customer_growth_get",
        "parameters": [
          {
            "in": "query",
            "name": "period",
            "required": false,
            "schema": {
              "default": "this_year",
              "title": "Period",
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "granularity",
            "required": false,
            "schema": {
              "default": "month",
              "title": "Granularity",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GrowthResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "security": [
          {
            "APIKeyHeader": []
          }
        ],
        "summary": "Get Customer Growth",
        "tags": [
          "Dashboard"
        ]
      }
    },
