    "/api/v1/inventory/search": {
      "get": {
        "operationId": "search_inventory_api_v1_inventory_search_get",
        "parameters": [
          {
            "description": "Type of inventory (flight, hotel, activity, train, bus, car)",
            "in": "query",
            "name": "type",
            "required": true,
            "schema": {
              "description": "Type of inventory (flight, hotel, activity, train, bus, car)",
              "title": "Type",
              "type": "string"
            }
          },
          {
            "description": "General location or destination",
            "in": "query",
            "name": "location",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "General location or destination",
              "title": "Location"
            }
          },
          {
            "description": "Departure code (for transport)",
            "in": "query",
            "name": "dep",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Departure code (for transport)",
              "title": "Dep"
            }
          },
          {
            "description": "Arrival code (for transport)",
            "in": "query",
            "name": "arr",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Arrival code (for transport)",
              "title": "Arr"
            }
          },
          {
            "description": "Date of travel or check-in",
            "in": "query",
            "name": "date",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Date of travel or check-in",
              "title": "Date"
            }
          },
          {
            "description": "budget level: economy, standard, luxury",
            "in": "query",
            "name": "budget",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": "standard",
              "description": "budget level: economy, standard, luxury",
              "title": "Budget"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/InventoryItem"
                  },
                  "title": "Response Search Inventory Api V1 Inventory Search Get",
                  "type": "array"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Search Inventory",
        "tags": [
          "Inventory",
          "inventory"
        ]
      }
