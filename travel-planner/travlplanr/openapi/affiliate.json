{
  "components": {
    "schemas": {
      "CreateBookingRequest": {
        "properties": {
          "amount": {
            "anyOf": [
              {
                "maximum": 1000000.0,
                "minimum": 0.0,
                "type": "number"
              },
              {
                "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
                "type": "string"
              }
            ],
            "default": "0.0",
            "title": "Amount"
          },
          "currency": {
            "default": "USD",
            "pattern": "^[A-Z]{3}$",
            "title": "Currency",
            "type": "string"
          },
          "packageId": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Packageid"
          },
          "tripId": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Tripid"
          }
        },
        "title": "CreateBookingRequest",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "InventoryItem": {
        "properties": {
          "currency": {
            "title": "Currency",
            "type": "string"
          },
          "deep_link": {
            "title": "Deep Link",
            "type": "string"
          },
          "details": {
            "anyOf": [
              {
                "additionalProperties": true,
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "title": "Details"
          },
          "duration": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Duration"
          },
          "end_time": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "End Time"
          },
          "id": {
            "title": "Id",
            "type": "string"
          },
          "image_url": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Image Url"
          },
          "price": {
            "title": "Price",
            "type": "number"
          },
          "provider": {
            "title": "Provider",
            "type": "string"
          },
          "start_time": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Start Time"
          },
          "title": {
            "title": "Title",
            "type": "string"
          },
          "type": {
            "title": "Type",
            "type": "string"
          }
        },
        "required": [
          "id",
          "type",
          "provider",
          "title",
          "price",
          "currency",
          "deep_link"
        ],
        "title": "InventoryItem",
        "type": "object"
      },
      "OrderBody": {
        "properties": {
          "payload": {
            "additionalProperties": true,
            "title": "Payload",
            "type": "object"
          }
        },
        "title": "OrderBody",
        "type": "object"
      },
      "RouteBody": {
        "properties": {
          "dest_lat": {
            "title": "Dest Lat",
            "type": "number"
          },
          "dest_lng": {
            "title": "Dest Lng",
            "type": "number"
          },
          "origin_lat": {
            "title": "Origin Lat",
            "type": "number"
          },
          "origin_lng": {
            "title": "Origin Lng",
            "type": "number"
          },
          "travel_mode": {
            "default": "DRIVE",
            "description": "DRIVE, WALK, BICYCLE, TRANSIT, TWO_WHEELER",
            "title": "Travel Mode",
            "type": "string"
          }
        },
        "required": [
          "origin_lat",
          "origin_lng",
          "dest_lat",
          "dest_lng"
        ],
        "title": "RouteBody",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    },
    "securitySchemes": {
      "APIKeyHeader": {
        "in": "header",
        "name": "X-API-Key",
        "type": "apiKey"
      }
    }
  },
  "info": {
    "description": "Bookings source of truth, inventory catalog.",
    "title": "Travlplanr Affiliate Service",
