    "/api/v1/inventory/places/autocomplete": {
      "get": {
        "description": "Google Places Autocomplete \u2014 server-side key, for destination typeahead.",
        "operationId": "places_autocomplete_api_v1_inventory_places_autocomplete_get",
        "parameters": [
          {
            "description": "Partial destination query",
            "in": "query",
            "name": "q",
            "required": true,
            "schema": {
              "description": "Partial destination query",
              "maxLength": 200,
              "minLength": 2,
              "title": "Q",
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "limit",
            "required": false,
            "schema": {
              "default": 6,
              "maximum": 12,
              "minimum": 1,
              "title": "Limit",
              "type": "integer"
            }
          },
          {
            "description": "Places Autocomplete types filter",
            "in": "query",
            "name": "types",
            "required": false,
            "schema": {
              "default": "(cities)",
              "description": "Places Autocomplete types filter",
              "title": "Types",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {}
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Places Autocomplete",
        "tags": [
          "Inventory",
          "inventory"
        ]
      }
    },
    "/api/v1/inventory/places/details": {
      "get": {
        "description": "Google Place Details \u2014 geometry, hours, rating, photo.",
        "operationId": "places_details_api_v1_inventory_places_details_get",
        "parameters": [
          {
            "in": "query",
            "name": "place_id",
            "required": true,
            "schema": {
              "maxLength": 256,
              "minLength": 3,
              "title": "Place Id",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {}
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
