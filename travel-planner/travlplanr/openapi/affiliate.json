              "application/json": {
                "schema": {}
              }
            },
            "description": "Successful Response"
          }
        },
        "security": [
          {
            "APIKeyHeader": []
          }
        ],
        "summary": "List Bookings",
        "tags": [
          "Bookings"
        ]
      },
      "post": {
        "description": "Create a booking. Idempotent based on trip_id / package_id.",
        "operationId": "create_booking_api_v1_bookings_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateBookingRequest"
