# Server dev stack (ai-server) — Ollama runs on host GPU, not in Docker.
CHAT_PROVIDER=ollama
GENERATION_PROVIDER=ollama
OLLAMA_BASE_URL=http://host.docker.internal:11434
# Share the same loaded weights as OneOps (travlplanr Modelfile aliases to qwen3.8-max).
OLLAMA_MODEL=qwen3.8-max
OLLAMA_NUM_CTX=131072
OLLAMA_KEEP_ALIVE=30m
OLLAMA_SHARED_MODEL=qwen3.8-max
CHAT_TOOLS_ENABLED=1
CHAT_MAX_TOKENS=450
CHAT_MAX_TOKENS_DETAIL=1000
CHAT_MAX_TOKENS_SHORT=280

# Voice input transcription (Firefox/Safari fallback — Chrome/Edge use the
# on-device Web Speech API and need none of this). Local whisper container
# is tried first; GROQ_API_KEY below is only used if that's unreachable.
LOCAL_WHISPER_URL=http://whisper:9000
# Transcription accuracy/CPU trade-off. If accented speech transcribes badly,
# uncomment the next line and `docker compose up -d whisper` (one-time model
# download). Options: base (default, fast) | small | medium | large-v3-turbo
#WHISPER_MODEL=small

ANTHROPIC_API_KEY=placeholder_key
GROQ_API_KEY=
GEMINI_API_KEY=
GOOGLE_API_KEY=
UNSPLASH_ACCESS_KEY=
IMAGE_SEARCH_CACHE_TTL_SECONDS=86400
IMAGE_FALLBACK_CACHE_TTL_SECONDS=3600

INTERNAL_API_SECRET=dev-internal-secret
EDGE_NGINX_CONF=./infra/edge/nginx.conf
