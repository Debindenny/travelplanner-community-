# Server dev stack (ai-server) — Ollama runs on host GPU, not in Docker.
# Local-only chat: never fall through to cloud providers.
CHAT_PROVIDER=ollama
GENERATION_PROVIDER=ollama
OLLAMA_BASE_URL=http://host.docker.internal:11434
# Share the same loaded weights as OneOps (travlplanr aliases to qwen3.8-max).
# Using one model name avoids GPU unload/reload thrash on a single L40.
OLLAMA_MODEL=qwen3.8-max
OLLAMA_NUM_CTX=131072
OLLAMA_KEEP_ALIVE=30m
OLLAMA_SHARED_MODEL=qwen3.8-max
CHAT_TOOLS_ENABLED=1
CHAT_MAX_TOKENS=450
CHAT_MAX_TOKENS_DETAIL=1000
CHAT_MAX_TOKENS_SHORT=280
GEMINI_MODEL=gemini-2.0-flash

# Voice input transcription (Firefox/Safari fallback — Chrome/Edge use the
# on-device Web Speech API and need none of this). Local whisper container
# is tried first; GROQ_API_KEY below is only used if that's unreachable.
LOCAL_WHISPER_URL=http://whisper:9000
# Transcription accuracy/CPU trade-off. If accented speech transcribes badly,
# uncomment the next line and `docker compose up -d whisper` (one-time model
# download). Options: base (default, fast) | small | medium | large-v3-turbo
#WHISPER_MODEL=small

# Leave blank unless you have a real Anthropic key (placeholder_key is ignored).
ANTHROPIC_API_KEY=
GROQ_API_KEY=
GEMINI_API_KEY=
GOOGLE_API_KEY=AIzaSyCsDHn0UC3zgaJN29-Rn-7jYp_4Bm_e6IA
# Places + Routes + Time Zone (server key). Enable legacy Places API + Generative Language for Gemini.
GOOGLE_PLACES_API_KEY=AIzaSyCsDHn0UC3zgaJN29-Rn-7jYp_4Bm_e6IA
# Browser Maps JavaScript key (HTTP-referrer restricted in prod). Same key works in
# local/dev when Maps JavaScript API is enabled and Application restrictions = None.
GOOGLE_MAPS_BROWSER_KEY=AIzaSyCsDHn0UC3zgaJN29-Rn-7jYp_4Bm_e6IA
AMADEUS_API_BASE_URL=https://test.api.amadeus.com
UNSPLASH_ACCESS_KEY=ITFUdmZ7THCTljrD_xvENMWdYzMwprcBALpqnl_l05U

